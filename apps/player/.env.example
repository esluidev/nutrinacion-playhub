# Apps que pueden incrustar el runner (docs/runner.md), separadas por comas. Se usa para los
# mensajes y para la cabecera frame-ancestors (al compilar).
NUXT_PUBLIC_RUNNER_HOSTS=http://localhost:3002,http://localhost:3000,http://localhost:3100

# Supabase: solo para la entrada de la gestión (superadmin). El runner /play/** no lo usa.
NUXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NUXT_PUBLIC_SUPABASE_ANON_KEY=
