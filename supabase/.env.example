# Secretos de las Edge Functions en local. Copia este archivo a `supabase/.env` (fuera de Git) y
# reinicia con `supabase stop && supabase start`. En la nube: `supabase secrets set RESEND_API_KEY=…`.

# Envío de invitaciones por correo (decisión 012). La key sale de resend.com → API Keys.
RESEND_API_KEY=

# Remitente. Vacío = «Nutrinación <hello@nutrinacion.com>», que exige el dominio verificado en
# Resend. Para probar sin dominio: onboarding@resend.dev (solo envía al correo de tu cuenta de Resend).
RESEND_FROM=
